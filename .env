# ==========================================
# 🔑 إعدادات البوت الأساسية
# ==========================================
# توكن البوت من Discord Developer Portal
DISCORD_TOKEN=

# منفذ خادم الويب للحفاظ على عمل البوت في Railway (اتركه 3000)
PORT=3000

# ==========================================
# 📁 إعدادات الفاصل (Separator)
# ==========================================
# اسم ملف الفاصل (separator.gif)
SEPARATOR_FILE=separator.gif

# أو يمكنك وضع رابط مباشر لصورة الفاصل من الإنترنت (اختياري)
SEPARATOR_URL=

# إرسال الفاصل بعد كم رسالة؟ (1 يعني بعد كل رسالة مباشرة)
SEPARATOR_INTERVAL=1

# تفعيل أو تعطيل إرسال الفاصل (true أو false)
ENABLE_SEPARATOR=true

# ==========================================
# 💬 إعدادات الرومات والرياكشنات
# ==========================================

# 1. روم التقييمات (رياكشن + فاصل معاً)
REVIEW_CHANNEL_ID=1447978433178239211
REVIEW_EMOJIS=⭐

# 2. روم الإثباتات (رياكشن فقط - بدون فاصل)
PROOFS_CHANNEL_ID=1551213877717639181
PROOFS_EMOJIS=✅

# 3. رومات إضافية (رياكشن فقط - مفصولة بفاصلة)
EXTRA_CHANNELS=
EXTRA_EMOJIS=❤️,🔥

# تجاهل رسائل البوتات لمنع التكرار (true أو false)
IGNORE_BOTS=true
