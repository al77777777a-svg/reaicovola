# ==========================================
# 🔑 إعدادات البوت الأساسية
# ==========================================
# توكن البوت من Discord Developer Portal
DISCORD_TOKEN=

# منفذ خادم الويب للحفاظ على عمل البوت في Railway (اتركه 3000)
PORT=3000

# ==========================================
# 📁 إعدادات الفاصل (Separator)
# ==========================================
# اسم ملف الفاصل (موجود مسبقاً في المجلد: separator.gif أو separator.webp أو separator-oryn-transparent.png)
SEPARATOR_FILE=separator.gif

# أو يمكنك وضع رابط مباشر لصورة الفاصل من الإنترنت بدلاً من الملف المحلي (اختياري)
SEPARATOR_URL=

# إرسال الفاصل بعد كم رسالة؟ (1 يعني بعد كل رسالة مباشرة، 2 يعني كل رسالتين، وهكذا)
SEPARATOR_INTERVAL=1

# تفعيل أو تعطيل إرسال الفاصل (true أو false)
ENABLE_SEPARATOR=true

# ==========================================
# 💬 إعدادات الرومات والرياكشنات
# ==========================================

# 1. روم التقييمات (Review)
REVIEW_CHANNEL_ID=
REVIEW_EMOJIS=⭐

# 2. روم الإثباتات (Proofs)
PROOFS_CHANNEL_ID=
PROOFS_EMOJIS=✅

# 3. رومات إضافية (يمكنك وضع آيديات أي رومات أخرى مفصولة بفاصلة)
# مثال: EXTRA_CHANNELS=123456789012345678,987654321098765432
EXTRA_CHANNELS=
# الرياكشنات للرومات الإضافية (يمكن وضع أكثر من إيموجي مفصولين بفاصلة)
EXTRA_EMOJIS=❤️,🔥

# تجاهل رسائل البوتات لمنع التكرار (true أو false)
IGNORE_BOTS=true
